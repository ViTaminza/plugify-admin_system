					"ref": false,
					"description": "0 = ban, 1 = mute, 2 = gag, 3 = silence."
				},
				{
					"name": "time",
					"type": "int32",
					"ref": false,
					"description": "Duration in seconds, 0 = permanent."
				},
				{
					"name": "reason",
					"type": "string",
					"ref": false,
